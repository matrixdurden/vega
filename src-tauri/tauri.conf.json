{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vega",
  "version": "0.2.0",
  "identifier": "io.github.matrixdurden.vega",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Vega",
        "width": 1100,
        "height": 700,
        "minWidth": 880,
        "minHeight": 580,
        "center": true,
        "decorations": false,
        "backgroundColor": "#0b0a1a"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https://cdn.modrinth.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "shortDescription": "Fast, simple, open source Minecraft launcher",
    "longDescription": "Vega is a lightweight Minecraft launcher with Fabric and Modrinth support.",
    "copyright": "Copyright © 2026 matrixdurden. GPL-3.0-or-later.",
    "license": "GPL-3.0-or-later",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
